<script>
    var running = false;

    function setStatus(text, active) {
        document.getElementById('status-text').textContent = text;
        var dot = document.getElementById('status-dot');
        if (active) dot.classList.add('running');
        else        dot.classList.remove('running');
    }

    function startMission() {
        if (running) return;
        running = true;
        document.getElementById('btn-start').disabled  = true;
        document.getElementById('btn-delete').disabled = true;
        setStatus('EXECUTING — MISSION IN PROGRESS...', true);

        var frame = document.getElementById('terminal-frame');
        frame.src = location.href.split('?')[0] + '?action=run';

        // Poll until the iframe is done loading
        frame.onload = function() {
            running = false;
            document.getElementById('btn-start').disabled  = false;
            document.getElementById('btn-delete').disabled = false;
            setStatus('MISSION COMPLETE — DISCONNECTED', false);
        };
    }

    function clearTerminal() {
        var frame = document.getElementById('terminal-frame');
        frame.src = 'about:blank';
        if (!running) setStatus('STANDBY — TERMINAL CLEARED', false);
    }

    function deleteFiles() {
        if (running) { showToast('Cannot delete while mission is running.', true); return; }
        document.getElementById('btn-delete').disabled = true;
        setStatus('DELETING FILES...', true);

        fetch(location.href.split('?')[0] + '?action=delete')
            .then(function(r){ return r.json(); })
            .then(function(data){
                var msg = '';
                if (data.deleted && data.deleted.length) msg += 'Deleted: ' + data.deleted.join(', ') + '. ';
                if (data.errors  && data.errors.length)  msg += 'Errors: '  + data.errors.join(', ');
                if (!msg) msg = 'Nothing to delete.';
                showToast(msg, data.status !== 'ok');
                setStatus('STANDBY — FILES PURGED', false);
            })
            .catch(function(e){
                showToast('Request failed: ' + e, true);
                setStatus('STANDBY', false);
            })
            .finally(function(){
                document.getElementById('btn-delete').disabled = false;
            });
    }

    function showToast(msg, isErr) {
        var t = document.getElementById('toast');
        t.textContent = msg;
        t.className = isErr ? 'err' : '';
        t.style.display = 'block';
        setTimeout(function(){ t.style.display='none'; }, 5000);
    }
</script>
