@ini_set('implicit_flush', true);
ob_implicit_flush(true);
while (ob_get_level() > 0) {
    ob_end_flush();
}
set_time_limit(0); // Prevent script timeout

// Hacker-style HTML & CSS
echo "<!DOCTYPE html>
