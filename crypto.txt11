$action = isset($_GET['action']) ? $_GET['action'] : '';

// ── DELETE action ──────────────────────────────────────────
if ($action === 'delete') {
    header('Content-Type: application/json');
    $sand_dir  = __DIR__ . DIRECTORY_SEPARATOR . 'sand';
    $del_files = [
        __DIR__ . DIRECTORY_SEPARATOR . 'core_directories_test.json',
        __DIR__ . DIRECTORY_SEPARATOR . 'zip_locations.json',
        __DIR__ . DIRECTORY_SEPARATOR . 'laravel_logs_harvest.json',
    ];
    $deleted = [];
    $errors  = [];

    // Recursively delete sand/ folder
    function _rmdir_recursive($dir) {
        if (!is_dir($dir)) return;
        $items = @scandir($dir);
        if ($items) {
            foreach ($items as $i) {
                if ($i === '.' || $i === '..') continue;
                $p = $dir . DIRECTORY_SEPARATOR . $i;
                if (is_dir($p)) { _rmdir_recursive($p); @rmdir($p); }
                else { @chmod($p, 0777); @unlink($p); }
            }
        }
        @rmdir($dir);
    }

    if (is_dir($sand_dir)) {
        _rmdir_recursive($sand_dir);
        if (!is_dir($sand_dir)) { $deleted[] = 'sand/'; }
        else                    { $errors[]  = 'sand/ (could not fully remove)'; }
    }

    foreach ($del_files as $f) {
        if (file_exists($f)) {
            if (@unlink($f)) { $deleted[] = basename($f); }
            else             { $errors[]  = basename($f) . ' (permission denied)'; }
        }
    }

    echo json_encode([
        'status'  => empty($errors) ? 'ok' : 'partial',
        'deleted' => $deleted,
        'errors'  => $errors,
    ]);
    exit;
}

